#!/usr/bin/env python3 -I
"""Digest the current session's transcript into a markdown file a fresh agent can read.

Keeps what people said and what the agent did (user turns, assistant text, tool calls with their
key arguments); drops tool output, thinking and harness noise. Each entry carries the transcript
line number (L123) so a reader can open the raw record with `sed -n '123p' <transcript>`.

usage: transcript-digest [--runtime claude|codex|cursor] [--session ID] [--cwd DIR] [--out FILE] [TRANSCRIPT]
Prints the digest path, the transcript path and session stats (turns, context tokens, fill when known).
"""
import argparse
import json
import os
import re
import sys
import tempfile
from datetime import datetime
from pathlib import Path

HOME = Path.home()
ARG_LIMIT = 300
NOISE = re.compile(r"<(system-reminder|manually_attached_skills|environment_context|skills_instructions|"
                   r"collaboration_instructions)>.*?</\1>", re.S)


def clip(s, n=ARG_LIMIT):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


def clean(text):
    text = NOISE.sub("", text or "")
    m = re.search(r"<user_query>(.*?)</user_query>", text, re.S)
    if m:
        text = m.group(1)
    return text.strip()


def tool_line(name, args):
    if isinstance(args, str):
        try:
            args = json.loads(args)
        except Exception:
            return f"- tool {name}: {clip(args)}"
    if not isinstance(args, dict):
        return f"- tool {name}: {clip(args)}"
    keys = [k for k in ("command", "cmd", "file_path", "path", "pattern", "url", "description", "prompt", "query")
            if k in args] or list(args)[:2]
    return f"- tool {name}: " + "; ".join(f"{k}={clip(args[k], 160)}" for k in keys)


# --- locating the transcript ------------------------------------------------------------------

def claude_dir(cwd):
    return HOME / ".claude" / "projects" / re.sub(r"[^A-Za-z0-9-]", "-", cwd)


def cursor_dir(cwd):
    return HOME / ".cursor" / "projects" / re.sub(r"[^A-Za-z0-9-]", "-", cwd.lstrip("/")) / "agent-transcripts"


def newest(paths):
    paths = [p for p in paths if p.is_file()]
    return max(paths, key=lambda p: p.stat().st_mtime) if paths else None


def codex_meta_cwd(path):
    with open(path, errors="replace") as f:
        for line in f:
            try:
                o = json.loads(line)
            except Exception:
                continue
            if o.get("type") == "session_meta":
                return (o.get("payload") or {}).get("cwd")
            break
    return None


def locate(runtime, session, cwd):
    found = []
    if runtime in (None, "claude"):
        d = claude_dir(cwd)
        if session and (d / f"{session}.jsonl").is_file():
            return "claude", d / f"{session}.jsonl"
        p = newest(d.glob("*.jsonl"))
        if p:
            found.append(("claude", p))
    if runtime in (None, "codex"):
        cands = sorted((HOME / ".codex" / "sessions").glob("*/*/*/rollout-*.jsonl"),
                       key=lambda p: p.stat().st_mtime, reverse=True)
        if session:
            cands = [p for p in cands if session in p.name] or cands
        for p in cands[:200]:
            if codex_meta_cwd(p) == cwd:
                found.append(("codex", p))
                break
    if runtime in (None, "cursor"):
        d = cursor_dir(cwd)
        if session and (d / session / f"{session}.jsonl").is_file():
            return "cursor", d / session / f"{session}.jsonl"
        p = newest(d.glob("*/*.jsonl"))
        if p:
            found.append(("cursor", p))
    if not found:
        sys.exit(f"no transcript found for cwd {cwd}" + (f" ({runtime})" if runtime else "")
                 + "; pass the transcript path explicitly")
    return max(found, key=lambda rp: rp[1].stat().st_mtime)


def sniff(path):
    with open(path, errors="replace") as f:
        head = f.read(4000)
    if '"session_meta"' in head or '"payload"' in head:
        return "codex"
    if '"sessionId"' in head or '"isSidechain"' in head:
        return "claude"
    return "cursor"


# --- readers: yield (lineno, role, text, tools, results, stamp) ---------------------------------

def blocks(content):
    """Normalise a message content (str | list of blocks) into (text, tools, results)."""
    text, tools, results = [], [], 0
    if isinstance(content, str):
        text.append(content)
    for b in content if isinstance(content, list) else []:
        t = b.get("type")
        if t in ("text", "input_text", "output_text"):
            text.append(b.get("text", ""))
        elif t == "tool_use":
            tools.append(tool_line(b.get("name"), b.get("input")))
        elif t == "tool_result":
            results += 1
    return "\n".join(text), tools, results


def read_claude(path):
    stats = {"model": None, "context_tokens": None}
    with open(path, errors="replace") as f:
        for n, line in enumerate(f, 1):
            try:
                o = json.loads(line)
            except Exception:
                continue
            if o.get("type") not in ("user", "assistant") or o.get("isSidechain"):
                continue
            stats.setdefault("cwd", o.get("cwd"))
            m = o.get("message") or {}
            text, tools, results = blocks(m.get("content"))
            if o["type"] == "assistant" and m.get("usage"):
                u = m["usage"]
                stats["context_tokens"] = sum(u.get(k) or 0 for k in
                                              ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
                stats["model"] = m.get("model")
            yield n, o["type"], text, tools, results, o.get("timestamp")
    yield None, "stats", stats, None, None, None


def read_codex(path):
    stats = {"model": None, "context_tokens": None, "context_window": None}
    with open(path, errors="replace") as f:
        for n, line in enumerate(f, 1):
            try:
                o = json.loads(line)
            except Exception:
                continue
            p = o.get("payload") or {}
            t, pt = o.get("type"), p.get("type")
            if t == "session_meta":
                stats["context_window"] = p.get("context_window")
                stats["cwd"] = p.get("cwd")
            elif t == "event_msg" and pt == "token_count" and p.get("info"):
                info = p["info"]
                stats["context_tokens"] = (info.get("last_token_usage") or {}).get("input_tokens")
                stats["context_window"] = info.get("model_context_window") or stats["context_window"]
            elif t == "event_msg" and pt == "thread_settings_applied":
                stats["model"] = (p.get("thread_settings") or {}).get("model") or stats["model"]
            elif t == "response_item":
                if pt == "message" and p.get("role") in ("user", "assistant"):
                    text, _, _ = blocks(p.get("content"))
                    if text.startswith("# AGENTS.md instructions") or text.startswith("<environment_context>"):
                        continue
                    yield n, p["role"], text, [], 0, o.get("timestamp")
                elif pt in ("function_call", "custom_tool_call"):
                    yield n, "assistant", "", [tool_line(p.get("name"), p.get("arguments", p.get("input")))], 0, o.get("timestamp")
                elif pt in ("function_call_output", "custom_tool_call_output"):
                    yield n, "user", "", [], 1, o.get("timestamp")
    yield None, "stats", stats, None, None, None


def read_cursor(path):
    with open(path, errors="replace") as f:
        for n, line in enumerate(f, 1):
            try:
                o = json.loads(line)
            except Exception:
                continue
            role = o.get("role")
            if role not in ("user", "assistant"):
                continue
            text, tools, results = blocks((o.get("message") or {}).get("content"))
            yield n, role, text, tools, results, None
    yield None, "stats", {"model": None, "context_tokens": None}, None, None, None


READERS = {"claude": read_claude, "codex": read_codex, "cursor": read_cursor}


# --- digest -----------------------------------------------------------------------------------

def stamp(ts):
    if not ts:
        return ""
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone().strftime(" %H:%M")
    except Exception:
        return ""


def digest(runtime, path, out):
    entries, stats, turns = [], {}, 0
    pending_results = 0
    for n, role, text, tools, results, ts in READERS[runtime](path):
        if role == "stats":
            stats = text
            break
        text = clean(text)
        if results and not text and not tools:
            pending_results += results
            continue
        if not text and not tools:
            continue
        if pending_results:
            entries.append(f"- {pending_results} tool result(s) omitted")
            pending_results = 0
        if role == "user":
            turns += 1
        head = f"### L{n} {role}{stamp(ts)}"
        body = "\n".join(filter(None, [text, *tools]))
        entries.append(f"{head}\n{body}")
    tokens = stats.get("context_tokens")
    window = stats.get("context_window")
    fill = f"{tokens:,} tokens" if tokens else "unknown"
    if tokens and window:
        fill += f" of {window:,} ({100 * tokens // window}%)"
    header = [
        f"# Session digest ({runtime})",
        f"- transcript: {path}",
        f"- cwd: {stats.get('cwd') or os.getcwd()}",
        f"- user turns: {turns}; model: {stats.get('model') or 'unknown'}; context at last reply: {fill}",
        "- raw record for entry L<n>: `sed -n '<n>p' <transcript>`; tool outputs live only there",
        "",
    ]
    out.write_text("\n".join(header) + "\n\n".join(entries) + "\n")
    return turns, fill


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("transcript", nargs="?")
    ap.add_argument("--runtime", choices=sorted(READERS))
    ap.add_argument("--session", help="session id; values starting with '$' (unsubstituted placeholders) are ignored")
    ap.add_argument("--cwd", default=os.getcwd())
    ap.add_argument("--out")
    a = ap.parse_args()
    session = None if not a.session or a.session.startswith("$") else a.session
    if a.transcript:
        path = Path(a.transcript).expanduser()
        runtime = a.runtime or sniff(path)
    else:
        runtime, path = locate(a.runtime, session, os.path.realpath(a.cwd))
    out = Path(a.out) if a.out else Path(tempfile.gettempdir()) / f"session-digest-{path.stem}.md"
    turns, fill = digest(runtime, path, out)
    print(f"digest: {out}\ntranscript: {path}\nruntime: {runtime}; user turns: {turns}; context at last reply: {fill}")


if __name__ == "__main__":
    main()
